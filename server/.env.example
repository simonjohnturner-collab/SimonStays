# Copy to .env and fill in. .env is gitignored.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staysync?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Base URL used when generating export-feed links (no trailing slash).
PUBLIC_BASE_URL="http://localhost:4000"
# How often the background sync polls channel calendars (cron expression).
SYNC_CRON="*/30 * * * *"
# Competitor market probe (the "building fill" gauge). Set to enable the daily
# probe of other operators' booking engines; leave unset to only probe on demand.
MARKET_CRON="20 3 * * *"
MARKET_WINDOW_DAYS=30

# Zoho IMAP — read Airbnb reservation emails to fill guest names (optional)
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_USER=
ZOHO_IMAP_PASSWORD=
ZOHO_IMAP_FOLDER=Inbox/Airbnb
ZOHO_IMAP_HOST_EMAIL=you@example.com
ZOHO_POLL_CRON=*/5 * * * *

# WhatsApp via Twilio (cleaner reminders + "booking confirmed" alerts to the host).
# The host alert goes to the host's Contact number (Account page).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=            # approved template for cleaner reminders
# TWILIO_WHATSAPP_BOOKING_CONTENT_SID=    # approved template for the host booking alert

# Guest messaging
# SHOPFRONT_URL=https://simonstays.co.za  # linked from the "new message" email
# MESSAGE_CRON=*/10 * * * *               # how often scheduled messages are checked

# Ask Simon (AI guest Q&A) — uses ANTHROPIC_API_KEY (same key as receipt reading)
# ASK_SIMON_MODEL=claude-opus-5-5

# Online card payments (Paygate PayWeb3). simulate | sandbox | live
# PAYMENT_MODE=simulate
# PAYGATE_ID=                  # Merchant Access Portal → PayWeb settings (sandbox uses Paygate's test account if unset)
# PAYGATE_KEY=                 # the PayWeb encryption key set in the same place
# PAYMENT_BASE_URL=           # optional: public address Paygate calls back (defaults to the address the guest used)
