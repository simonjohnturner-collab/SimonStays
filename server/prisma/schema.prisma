// StaySync data model — multi-tenant property calendar + channel manager.
// Host owns Properties, each Property has Units, each Unit has a calendar of
// Bookings and any number of ChannelConnections (Airbnb/Booking/LekkeSlaap/manual).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Host {
  id           String     @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  properties    Property[]
  guestLookups  GuestLookup[]
  biller        BillerProfile?
  invoices      Invoice[]
  pricingGroups PricingGroup[]
  bookings      Booking[]
}

// The host's own "invoice from" details + bank info (one per host, editable).
model BillerProfile {
  id                 String   @id @default(uuid())
  hostId             String   @unique
  host               Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  companyName        String?
  registrationNo     String?
  addressLines       String? // multi-line
  email              String?
  phone              String?
  bankName           String?
  accountNumber      String?
  branch             String?
  swiftCode          String?
  paymentInstruction String? // e.g. "Pls Pay Catwalk Property Services"
  specialConditions  String? // default special conditions block
  invoiceSeq         Int      @default(0) // running invoice number
  updatedAt          DateTime @updatedAt
}

// A saved invoice. Line items + biller details are snapshotted as JSON so a
// historical invoice never changes when the profile is later edited.
model Invoice {
  id              String   @id @default(uuid())
  hostId          String
  host            Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  number          String
  date            DateTime @default(now())
  invoiceType     String   @default("Accommodation")
  bookingId       String?
  billToName      String?
  billToAddress   String?
  billToAttention String?
  billToEmail     String?
  billToPhone     String?
  lineItems       Json // [{description,dateIn,dateOut,qty,nightlyCents,amountCents}]
  discountPercent Float    @default(0)
  totalCents      Int      @default(0)
  dueNowCents     Int      @default(0)
  specialConditions String?
  billerSnapshot  Json?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hostId])
}

// Guest name for a reservation code, harvested from the host's Airbnb emails
// (Airbnb's iCal never includes the name; the email does, keyed by the same code).
model GuestLookup {
  id         String   @id @default(uuid())
  hostId     String
  host       Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  resCode    String
  guestName  String
  phoneLast4 String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hostId, resCode])
  @@index([hostId])
}

model Property {
  id          String   @id @default(uuid())
  hostId      String
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  description String? // listing description (for the public booking site)
  sortOrder   Int      @default(0) // manual order on the board (lower = higher up)
  createdAt   DateTime @default(now())
  units       Unit[]
  photos      Photo[]

  @@index([hostId])
}

// A pricing group: units assigned to the same group share one set of prices.
// Shared by the booking form and invoices (and later guest self-booking).
model PricingGroup {
  id                   String @id @default(uuid())
  hostId               String
  host                 Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name                 String
  units                Unit[]
  breakageDepositCents Int    @default(0)
  // nightly rate: first night, then every night thereafter (cents)
  firstNightCents      Int?
  additionalNightCents Int?
  weeklyDiscountPercent  Float @default(0) // 7+ nights
  monthlyDiscountPercent Float @default(0) // 28+ nights
  // per-night upward flexes (%)
  weekendFlexPercent Float @default(0) // Fri & Sat nights
  flex1Percent       Float @default(0) // Seasonal upward Flex 1
  flex2Percent       Float @default(0) // Seasonal upward Flex 2
  flex3Percent       Float @default(0) // Seasonal upward Flex 3
  // fees
  earlyCheckInCents Int @default(0)
  lateCheckOutCents Int @default(0)
  cleaningCents     Int @default(0) // per clean
  mattressCents     Int @default(0)
  // each seasonal flex can apply to MULTIPLE periods: [{flex:'flex1'|'flex2'|'flex3', start, end}]
  specialDates Json?
  bookings     Booking[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hostId])
}

model Unit {
  id           String              @id @default(uuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int?
  description  String? // listing description (for the public booking site)
  publishToken String              @default(cuid()) // secret in the export-feed URL
  createdAt    DateTime            @default(now())
  bookings       Booking[]
  channels       ChannelConnection[]
  syncLogs       SyncLog[]
  photos         Photo[]
  pricingGroupId String?
  pricingGroup   PricingGroup?       @relation(fields: [pricingGroupId], references: [id], onDelete: SetNull)

  @@index([propertyId])
}

// A listing photo for a Property or a Unit. Bytes are stored in Postgres so
// images persist across Render redeploys (the free-tier filesystem is ephemeral).
model Photo {
  id          String    @id @default(uuid())
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  data        Bytes // resized JPEG/PNG bytes
  contentType String
  filename    String?
  sort        Int       @default(0) // lower = earlier; the cover is the lowest
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model ChannelConnection {
  id           String      @id @default(uuid())
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type         ChannelType
  label        String?
  importUrl    String? // the channel's iCal export URL we pull FROM
  lastSyncedAt DateTime?
  lastStatus   String?
  createdAt    DateTime    @default(now())

  @@index([unitId])
}

model Booking {
  id           String        @id @default(uuid())
  unitId       String? // null = floating (unallocated) booking
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostId       String? // set on manual/floating bookings so floating ones have an owner
  host         Host?         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  source       BookingSource @default(manual)
  channelType  ChannelType?
  status       BookingStatus @default(confirmed)
  guestName    String?
  checkIn      DateTime // date-only (stored at noon UTC)
  checkOut     DateTime // checkout day = exclusive of last night; the clean day
  paid         Boolean       @default(false) // true only when fully paid
  paymentStatus String       @default("unpaid") // 'paid' | 'partial' | 'unpaid'
  amountOwingCents Int? // optional, for partial payments
  cleaner      String?
  comments     String?
  leavingEarly Boolean       @default(false)
  // Guest requests / add-ons
  earlyCheckIn  Boolean @default(false)
  lateCheckOut  Boolean @default(false)
  extraMattress Boolean @default(false)
  hairDryer     Boolean @default(false)
  // cleaner = the CHECKOUT clean's cleaner (field above). Insta (mid-stay) cleans:
  cleans       Clean[]
  externalUid  String? // channel event UID, for idempotent upsert
  resCode      String? // Airbnb reservation code, for guest-name lookup
  // Floating bookings can be tagged with a group → shown on the first free unit
  // in that group, WITHOUT blocking the channel (stays floating).
  pricingGroupId String?
  pricingGroup   PricingGroup? @relation(fields: [pricingGroupId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([unitId, externalUid])
  @@index([unitId, checkIn, checkOut])
  @@index([hostId, status])
}

model SyncLog {
  id          String       @id @default(uuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  channelType ChannelType?
  ranAt       DateTime     @default(now())
  added       Int          @default(0)
  updated     Int          @default(0)
  removed     Int          @default(0)
  ok          Boolean      @default(true)
  message     String?

  @@index([unitId, ranAt])
}

// A mid-stay "insta" clean on a booking (the checkout clean is Booking.cleaner).
model Clean {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date          DateTime? // day of the clean (optional); shown on the board when set
  paymentMethod String   @default("prepaid") // 'prepaid' (paid up front) | 'direct' (guest pays cleaner)
  cleaner       String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

enum ChannelType {
  airbnb
  booking
  lekkeslaap
  other
  manual
}

enum BookingSource {
  manual
  airbnb
  booking
  lekkeslaap
  import
  website
}

enum BookingStatus {
  confirmed
  floating
  cancelled
  pending // website hold awaiting payment; does NOT block the calendar
}
