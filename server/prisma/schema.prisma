// StaySync data model — multi-tenant property calendar + channel manager.
// Host owns Properties, each Property has Units, each Unit has a calendar of
// Bookings and any number of ChannelConnections (Airbnb/Booking/LekkeSlaap/manual).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Host {
  id           String     @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  contactPhone String?
  cleaners     Json          @default("[]") // list of cleaner names for dropdowns
  // Payout details — where SimonStays pays this host out for the bookings it collects.
  payoutMethod        String? // e.g. "Bank transfer (EFT)"
  payoutBankName      String?
  payoutAccountName   String? // account holder
  payoutAccountNumber String?
  payoutBranchCode    String?
  payoutNotes         String?
  createdAt    DateTime      @default(now())
  properties    Property[]
  guestLookups  GuestLookup[]
  biller        BillerProfile?
  invoices      Invoice[]
  pricingGroups PricingGroup[]
  bookings      Booking[]
  formTemplates   FormTemplate[]
  formSubmissions FormSubmission[]
  serviceProviders ServiceProvider[]
  guests           Guest[]
  photos           Photo[]           @relation("HostPhotos")
  lockProvider     LockProvider?
  competitors      Competitor[]
}

// A host's connection to a smart-lock cloud provider (RemoteLock). Holds the
// OAuth credentials + tokens so we can pull live device data (battery, status,
// access codes) into the SmartLock dashboard.
model LockProvider {
  id           String    @id @default(uuid())
  hostId       String    @unique
  host         Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  vendor       String    @default("remotelock")
  clientId     String?
  clientSecret String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  connectedAt  DateTime?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
}

// A service provider the host works with — cleaners, electricians, plumbers,
// handymen, etc. (Cleaners here feed the checkout-cleaner dropdowns.)
model ServiceProvider {
  id        String   @id @default(uuid())
  hostId    String
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name        String
  role        String   @default("Cleaner") // Cleaner | Electrician | Plumber | Handyman | Other…
  phone       String?
  notes       String?
  propertyIds Json     @default("[]") // ids of properties this provider works in
  unitIds     Json     @default("[]") // (dormant) previously per-unit allocation
  createdAt   DateTime @default(now())

  @@index([hostId])
}

// A guest contact-book entry — built up from bookings, invoices and direct
// bookings so the host keeps a track record (contact details, notes, damages).
model Guest {
  id        String   @id @default(uuid())
  hostId    String
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String? // business/postal address
  notes     String?
  damages   String? // running record of previous damages
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
}

// A guest's own login for the public shopfront. Separate from the host-scoped
// Guest contact-book (which is the host's notes about people): this is an
// account the guest creates to view their upcoming + previous trips. A guest
// may book across hosts, so this is NOT host-scoped. Bookings are linked to it
// explicitly (guestAccountId, stamped when booking while signed in) and by email.
model GuestAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

// The host's own "invoice from" details + bank info (one per host, editable).
model BillerProfile {
  id                 String   @id @default(uuid())
  hostId             String   @unique
  host               Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  companyName        String?
  registrationNo     String?
  addressLines       String? // multi-line
  email              String?
  phone              String?
  bankName           String?
  accountNumber      String?
  branch             String?
  swiftCode          String?
  paymentInstruction String? // e.g. "Pls Pay Catwalk Property Services"
  specialConditions  String? // default special conditions block
  invoiceSeq         Int      @default(0) // running invoice number
  updatedAt          DateTime @updatedAt
}

// A saved invoice. Line items + biller details are snapshotted as JSON so a
// historical invoice never changes when the profile is later edited.
model Invoice {
  id              String   @id @default(uuid())
  hostId          String
  host            Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  number          String
  date            DateTime @default(now())
  invoiceType     String   @default("Accommodation")
  bookingId       String?
  billToName      String?
  billToAddress   String?
  billToAttention String?
  billToEmail     String?
  billToPhone     String?
  lineItems       Json // [{description,dateIn,dateOut,qty,nightlyCents,amountCents}]
  discountPercent Float    @default(0)
  totalCents      Int      @default(0)
  dueNowCents     Int      @default(0)
  specialConditions String?
  billerSnapshot  Json?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hostId])
}

// Guest name for a reservation code, harvested from the host's Airbnb emails
// (Airbnb's iCal never includes the name; the email does, keyed by the same code).
model GuestLookup {
  id         String   @id @default(uuid())
  hostId     String
  host       Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  resCode    String
  guestName  String
  phoneLast4 String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hostId, resCode])
  @@index([hostId])
}

model Property {
  id          String   @id @default(uuid())
  hostId      String
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  description String? // listing description (for the public booking site)
  // ---- listing attributes (populated on the Listings page) ----
  latitude     Float?  // map pin
  longitude    Float?
  security     String? // what security is available
  access       String? // how you reach the units: Stairs | Lift | Stairs & lift
  checkInTime  String? // e.g. "14:00"
  checkOutTime String? // e.g. "10:00"
  backupPower  String? // e.g. "Yes — inverter runs lights & wifi"
  backupWater  String? // e.g. "Yes — 2500L tank"
  parkingBays  Int?    // number of bays
  parkingNotes String? // where they are
  cancellationPolicy String? // shown on the shopfront; falls back to the standard policy
  cleanRateCents Int?    // what a cleaner is paid per checkout clean here (the day's fee), in cents
  sortOrder   Int      @default(0) // manual order on the board (lower = higher up)
  createdAt   DateTime @default(now())
  units       Unit[]
  photos      Photo[]
  formSubmissions FormSubmission[]

  @@index([hostId])
}

// A pricing group: units assigned to the same group share one set of prices.
// Shared by the booking form and invoices (and later guest self-booking).
model PricingGroup {
  id                   String @id @default(uuid())
  hostId               String
  host                 Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name                 String
  units                Unit[]
  breakageDepositCents Int    @default(0)
  // nightly rate: first night, then every night thereafter (cents)
  firstNightCents      Int?
  additionalNightCents Int?
  weekendNightCents    Int? // optional Fri/Sat nightly rate — overrides the nightly rate on weekend nights when set
  weeklyDiscountPercent  Float @default(10) // 7+ nights
  monthlyDiscountPercent Float @default(20) // 28+ nights
  // Up to 4 seasonal upward flexes, each its own period + %: [{start, end, percent}]
  // Dates match by month-day (recurring annually); Dec->Jan wraps.
  flexes Json @default("[]")
  // fees
  earlyCheckInCents Int @default(0)
  lateCheckOutCents Int @default(0)
  cleaningCents     Int @default(0) // per clean
  mattressCents     Int @default(0)
  // --- dormant (superseded by `flexes`), kept to avoid data loss on migrate ---
  weekendFlexPercent Float @default(0)
  flex1Percent       Float @default(0)
  flex2Percent       Float @default(0)
  flex3Percent       Float @default(0)
  specialDates Json?
  bookings     Booking[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hostId])
}

model Unit {
  id           String              @id @default(uuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int?
  minNights    Int? // minimum nights per booking (null / 0 = no minimum)
  bedrooms     Int? // for form logic: repeat per-bedroom questions
  bathrooms    Int? // for form logic: repeat per-bathroom questions
  wifiName     String? // per-unit Wi-Fi network name
  wifiPassword String? // per-unit Wi-Fi password
  // ---- per-unit listing attributes ----
  checkInTime  String? @default("15:00")
  checkOutTime String? @default("10:00")
  security     String?
  access       String? // Ground floor | Stairs | Lift | Stairs & lift
  accessMethod String? // how guests get in: Lockbox | Smart lock | Remote garage door control
  smartLockUrl String? // link to the smart lock (to configure check-in/out later)
  lockBattery  Int?    // smart-lock battery % (from provider, or set manually)
  // ---- smart-lock provider (RemoteLock) link ----
  lockDeviceId   String?   // the provider's device id this unit is linked to
  lockDeviceName String?   // provider's name for the device (for matching)
  lockData       Json?     // last full attributes returned by the provider
  lockSyncedAt   DateTime? // when lockData was last refreshed from the provider
  backupPower  String?
  backupWater  String?
  parkingBays  Int?
  parkingNotes String?
  description  String? // listing description (for the public booking site)
  publishToken String              @default(cuid()) // secret in the export-feed URL
  createdAt    DateTime            @default(now())
  bookings       Booking[]
  channels       ChannelConnection[]
  syncLogs       SyncLog[]
  photos         Photo[]
  formSubmissions FormSubmission[]
  nightPrices    NightPrice[]
  pricingGroupId String?
  pricingGroup   PricingGroup?       @relation(fields: [pricingGroupId], references: [id], onDelete: SetNull)

  @@index([propertyId])
}

// A manual per-night base-rate override for one unit on one date. Replaces the
// rate-card base nightly rate for that night only (fees/cleaning/deposit unchanged).
model NightPrice {
  id         String   @id @default(uuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date       DateTime // date-only (stored at noon UTC) — the night being priced
  priceCents Int
  createdAt  DateTime @default(now())

  @@unique([unitId, date])
  @@index([unitId, date])
}

// A listing photo for a Property or a Unit. Bytes are stored in Postgres so
// images persist across Render redeploys (the free-tier filesystem is ephemeral).
model Photo {
  id          String    @id @default(uuid())
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // A photo can instead belong to a form submission (guest/cleaner uploads).
  formSubmissionId String?
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  // …or be a host's profile photo ("Hosted by").
  hostId      String?
  hostProfile Host?     @relation("HostPhotos", fields: [hostId], references: [id], onDelete: Cascade)
  fieldId     String? // which form question this photo answers
  data        Bytes // resized JPEG/PNG bytes
  contentType String
  filename    String?
  sort        Int       @default(0) // lower = earlier; the cover is the lowest
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([unitId])
  @@index([formSubmissionId])
}

// An editable form definition (the questions). The host designs these in the
// admin; the public forms site renders whatever is defined here.
model FormTemplate {
  id          String   @id @default(uuid())
  hostId      String
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  type        String // 'damage' (guest issue report) | 'clean' (cleaner checkout report)
  name        String   @default("Checkout clean") // label for clean forms (e.g. "Firenza", "Rosebank")
  unitIds     Json     @default("[]") // clean forms: which unit ids this form applies to
  title       String
  description String?
  // ordered questions: [{ id, label, type, required, options?, help? }]
  // type ∈ text | textarea | number | money | select | checkbox | date | rating | photos
  fields      Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostId, type])
}

// A completed form (guest damage report or cleaner checkout report) + its photos.
model FormSubmission {
  id               String    @id @default(uuid())
  hostId           String
  host             Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  type             String // 'damage' | 'clean'
  templateId       String?
  propertyId       String?
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId           String?
  unit             Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  submitterName    String?
  submitterContact String?
  answers          Json      @default("{}") // { fieldId: value }
  status           String    @default("new") // new | reviewed | resolved
  photos           Photo[]
  createdAt        DateTime  @default(now())

  // Cleaner day-settlement (checkout cleans): what I still owe the cleaner.
  reimbursedCents  Int?      // amount I've already paid the cleaner back for purchases
  cleanerFeeCents  Int?      // this clean's daily fee (defaults to the property's cleanRateCents)

  // Repair reports: which damage report (if any) this repair resolves. Linking a
  // repair marks that damage submission 'resolved' — the raised→resolved tie-up.
  resolvesSubmissionId String?

  // AI receipt/till-slip analysis of any purchase photos on this submission.
  purchaseSummary  Json?     // { merchant, purchaseDate, currency, items[], totalCents, totalsMatch, summary, model, generatedAt }
  purchaseStatus   String?   // pending | done | failed | no_key | none
  purchaseItems    PurchaseItem[]

  @@index([hostId, type, createdAt])
  @@index([propertyId])
}

// One extracted line item from a cleaner's purchase receipt. Normalised (not just
// JSON on the submission) so we can trend spend over time — per cleaner, unit,
// property or category — and track when durable items were last replaced.
model PurchaseItem {
  id             String         @id @default(uuid())
  hostId         String
  submissionId   String
  submission     FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  propertyId     String?
  unitId         String?
  cleanerName    String?
  purchasedAt    DateTime // receipt date when readable, else the submission date
  name           String // recognisable product name (till abbreviation expanded, e.g. "Handy Andy")
  category       String? // normalised bucket (Cleaning supplies, Linen & towels, …)
  quantity       Float?         @default(1)
  unitPriceCents Int?
  lineTotalCents Int?
  currency       String?        @default("ZAR")
  isReplacement  Boolean        @default(false) // durable item (kettle, iron, linen) vs consumable
  createdAt      DateTime       @default(now())

  @@index([hostId, purchasedAt])
  @@index([unitId, category])
  @@index([propertyId, category])
  @@index([submissionId])
}

model ChannelConnection {
  id           String      @id @default(uuid())
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type         ChannelType
  label        String?
  importUrl    String? // the channel's iCal export URL we pull FROM
  lastSyncedAt DateTime?
  lastStatus   String?
  createdAt    DateTime    @default(now())

  @@index([unitId])
}

model Booking {
  id           String        @id @default(uuid())
  unitId       String? // null = floating (unallocated) booking
  unit         Unit?         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostId       String? // set on manual/floating bookings so floating ones have an owner
  host         Host?         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  source       BookingSource @default(manual)
  channelType  ChannelType?
  status       BookingStatus @default(confirmed)
  guestName    String?
  // Structured guest contact (website bookings) — also used to match a booking
  // to a GuestAccount by email so guests see their trips. Historically these
  // lived only inside `comments`; a startup backfill fills them for old rows.
  guestEmail   String?
  guestPhone   String?
  totalCents   Int?    // payable total captured at booking time (website bookings)
  guestAccountId String?
  guestAccount   GuestAccount? @relation(fields: [guestAccountId], references: [id], onDelete: SetNull)
  checkIn      DateTime // date-only (stored at noon UTC)
  checkOut     DateTime // checkout day = exclusive of last night; the clean day
  paid         Boolean       @default(false) // true only when fully paid
  paymentStatus String       @default("unpaid") // 'paid' | 'partial' | 'unpaid'
  quotedCents   Int? // amount actually quoted to the guest (may differ from the pricing-schedule calc)
  amountPaidCents Int? // how much the guest has actually paid so far
  amountOwingCents Int? // outstanding = quoted − paid (derived; kept for the board/invoice)
  ref           String? // human-friendly booking reference (website bookings), used as the EFT payment reference
  billingDetails String? // optional business/billing details the guest entered for their invoice
  termsAcceptedAt DateTime? // when the guest ticked the T&Cs + cancellation policy at checkout (chargeback evidence)
  depositCents  Int?    // refundable breakage deposit collected on the shopfront
  depositStatus String? // null (none) | 'held' | 'refunded' | 'forfeited'
  cleaner      String?
  comments     String?
  accessCode   String? // smart-lock code for this stay
  leavingEarly Boolean       @default(false)
  // Guest requests / add-ons
  earlyCheckIn  Boolean @default(false)
  lateCheckOut  Boolean @default(false)
  extraMattress Boolean @default(false)
  hairDryer     Boolean @default(false)
  // cleaner = the CHECKOUT clean's cleaner (field above). Insta (mid-stay) cleans:
  cleans       Clean[]
  externalUid  String? // channel event UID, for idempotent upsert
  resCode      String? // Airbnb reservation code, for guest-name lookup
  // Floating bookings can be tagged with a group → shown on the first free unit
  // in that group, WITHOUT blocking the channel (stays floating).
  pricingGroupId String?
  pricingGroup   PricingGroup? @relation(fields: [pricingGroupId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([unitId, externalUid])
  @@index([unitId, checkIn, checkOut])
  @@index([hostId, status])
  @@index([guestAccountId])
  @@index([guestEmail])
}

model SyncLog {
  id          String       @id @default(uuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  channelType ChannelType?
  ranAt       DateTime     @default(now())
  added       Int          @default(0)
  updated     Int          @default(0)
  removed     Int          @default(0)
  ok          Boolean      @default(true)
  message     String?

  @@index([unitId, ranAt])
}

// A mid-stay "insta" clean on a booking (the checkout clean is Booking.cleaner).
model Clean {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date          DateTime? // day of the clean (optional); shown on the board when set
  paymentMethod String   @default("prepaid") // 'prepaid' (paid up front) | 'direct' (guest pays cleaner)
  cleaner       String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

enum ChannelType {
  airbnb
  booking
  lekkeslaap
  other
  manual
}

enum BookingSource {
  manual
  airbnb
  booking
  lekkeslaap
  import
  website
}

enum BookingStatus {
  confirmed
  floating
  cancelled
  pending // website hold awaiting payment; does NOT block the calendar
}

// ---- Competitor market intelligence (the "building fill" gauge) ----
// Tracks other operators in the same building (e.g. The Vantage, Rosebank) so we
// can see how full the building is running and price our own units against the
// live market. A Competitor is one operator; MarketSnapshot rows are the
// per-night, per-room-type observations captured on each probe run.

enum MarketSource {
  SITEMINDER_TBB // SiteMinder "The Booking Button" GraphQL (direct-book.com) — e.g. CAG
  OTA            // read from an OTA listing (Booking.com/Agoda) — manual or scraped
  MANUAL         // hand-entered weekly snapshot
}

model Competitor {
  id          String       @id @default(uuid())
  hostId      String
  host        Host         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name        String       // e.g. "CAG — The Vantage"
  building    String?      // e.g. "The Vantage, Rosebank" — groups operators we compare
  source      MarketSource @default(MANUAL)
  // SiteMinder TBB: the booking channel code (the direct-book.com URL slug),
  // e.g. "TheVantageDirect". Null for MANUAL/OTA competitors.
  channelCode String?
  // Optional override of the GraphQL host (defaults to https://direct-book.com).
  apiBase     String?
  currency    String       @default("ZAR")
  // Best estimate of how many physical units this operator runs in the building,
  // keyed by room type, e.g. { "Studio Apartment": 10, "One Bedroom Apartment": 8 }.
  // Used to weight the occupancy index; free-form so it can be filled over time.
  unitCounts  Json         @default("{}")
  active      Boolean      @default(true)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  snapshots   MarketSnapshot[]

  @@index([hostId])
}

// One observation: for a competitor's room type, on one stay-date, as seen on one
// capture run — was a booking quotable and at what price. The time-series behind
// the occupancy + price charts. One row per (competitor, room type, stay date)
// per capture day, so a re-run on the same day updates rather than duplicates.
model MarketSnapshot {
  id            String     @id @default(uuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capturedAt    DateTime   @default(now()) // exact time of the probe run
  capturedDate  DateTime   // date-only (noon UTC) of the run — the daily bucket
  stayDate      DateTime   // date-only (noon UTC) — the night being priced
  roomType      String     // e.g. "Studio Apartment"
  roomTypeExtId String?    // provider's room-type uuid, when known
  available     Boolean    // did the engine return a bookable quote for this night?
  availableUnits Int?      // units bookable per minAvailability (gated to 0 server-side; kept for reference)
  priceCents    Int?       // standard-rate nightly price (gross, incl. tax)
  promoPriceCents Int?     // promotional-rate nightly price when one is offered (measures discount depth)
  currency      String     @default("ZAR")
  raw           Json?      // trimmed provider payload, kept for debugging
  createdAt     DateTime   @default(now())

  @@unique([competitorId, stayDate, roomType, capturedDate])
  @@index([competitorId, stayDate])
  @@index([competitorId, capturedDate])
}
