// StaySync data model — multi-tenant property calendar + channel manager.
// Host owns Properties, each Property has Units, each Unit has a calendar of
// Bookings and any number of ChannelConnections (Airbnb/Booking/LekkeSlaap/manual).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Host {
  id           String     @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  properties   Property[]
  guestLookups GuestLookup[]
  biller       BillerProfile?
  invoices     Invoice[]
}

// The host's own "invoice from" details + bank info (one per host, editable).
model BillerProfile {
  id                 String   @id @default(uuid())
  hostId             String   @unique
  host               Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  companyName        String?
  registrationNo     String?
  addressLines       String? // multi-line
  email              String?
  phone              String?
  bankName           String?
  accountNumber      String?
  branch             String?
  swiftCode          String?
  paymentInstruction String? // e.g. "Pls Pay Catwalk Property Services"
  specialConditions  String? // default special conditions block
  invoiceSeq         Int      @default(0) // running invoice number
  updatedAt          DateTime @updatedAt
}

// A saved invoice. Line items + biller details are snapshotted as JSON so a
// historical invoice never changes when the profile is later edited.
model Invoice {
  id              String   @id @default(uuid())
  hostId          String
  host            Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  number          String
  date            DateTime @default(now())
  invoiceType     String   @default("Accommodation")
  bookingId       String?
  billToName      String?
  billToAddress   String?
  billToAttention String?
  billToEmail     String?
  billToPhone     String?
  lineItems       Json // [{description,dateIn,dateOut,qty,nightlyCents,amountCents}]
  discountPercent Float    @default(0)
  totalCents      Int      @default(0)
  dueNowCents     Int      @default(0)
  specialConditions String?
  billerSnapshot  Json?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hostId])
}

// Guest name for a reservation code, harvested from the host's Airbnb emails
// (Airbnb's iCal never includes the name; the email does, keyed by the same code).
model GuestLookup {
  id         String   @id @default(uuid())
  hostId     String
  host       Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  resCode    String
  guestName  String
  phoneLast4 String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hostId, resCode])
  @@index([hostId])
}

model Property {
  id        String   @id @default(uuid())
  hostId    String
  host      Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  createdAt DateTime @default(now())
  units     Unit[]
  rateCard  RateCard?

  @@index([hostId])
}

// Per-property pricing sheet, shared by the booking form and invoices.
model RateCard {
  id                String    @id @default(uuid())
  propertyId        String    @unique
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // per-night rate by length of stay (cents); null tiers fall back to the nearest set one
  nights1Cents      Int?
  nights2Cents      Int?
  nights3Cents      Int?
  nights4Cents      Int?
  nights5PlusCents  Int?
  weeklyDiscountPercent  Float @default(0) // 7+ nights
  monthlyDiscountPercent Float @default(0) // 28+ nights
  cleaningCents     Int       @default(0)
  mattressCents     Int       @default(0)
  // per-night surcharges (%)
  weekendSurchargePercent       Float @default(0) // Fri & Sat nights
  publicHolidaySurchargePercent Float @default(0)
  christmasSurchargePercent     Float @default(0)
  easterSurchargePercent        Float @default(0)
  // date ranges the surcharges apply to: [{category:'public'|'christmas'|'easter', start, end, label}]
  specialDates      Json?
  updatedAt         DateTime  @updatedAt
}

model Unit {
  id           String              @id @default(uuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int?
  publishToken String              @default(cuid()) // secret in the export-feed URL
  createdAt    DateTime            @default(now())
  bookings     Booking[]
  channels     ChannelConnection[]
  syncLogs     SyncLog[]

  @@index([propertyId])
}

model ChannelConnection {
  id           String      @id @default(uuid())
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type         ChannelType
  label        String?
  importUrl    String? // the channel's iCal export URL we pull FROM
  lastSyncedAt DateTime?
  lastStatus   String?
  createdAt    DateTime    @default(now())

  @@index([unitId])
}

model Booking {
  id           String        @id @default(uuid())
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source       BookingSource @default(manual)
  channelType  ChannelType?
  status       BookingStatus @default(confirmed)
  guestName    String?
  checkIn      DateTime // date-only (stored at noon UTC)
  checkOut     DateTime // checkout day = exclusive of last night; the clean day
  paid         Boolean       @default(false)
  cleaner      String?
  comments     String?
  leavingEarly Boolean       @default(false)
  // Guest requests / add-ons
  earlyCheckIn  Boolean @default(false)
  lateCheckOut  Boolean @default(false)
  extraMattress Boolean @default(false)
  hairDryer     Boolean @default(false)
  // cleaner = the CHECKOUT clean's cleaner (field above). Insta (mid-stay) cleans:
  cleans       Clean[]
  externalUid  String? // channel event UID, for idempotent upsert
  resCode      String? // Airbnb reservation code, for guest-name lookup
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([unitId, externalUid])
  @@index([unitId, checkIn, checkOut])
}

model SyncLog {
  id          String       @id @default(uuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  channelType ChannelType?
  ranAt       DateTime     @default(now())
  added       Int          @default(0)
  updated     Int          @default(0)
  removed     Int          @default(0)
  ok          Boolean      @default(true)
  message     String?

  @@index([unitId, ranAt])
}

// A mid-stay "insta" clean on a booking (the checkout clean is Booking.cleaner).
model Clean {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date          DateTime? // day of the clean (optional); shown on the board when set
  paymentMethod String   @default("prepaid") // 'prepaid' (paid up front) | 'direct' (guest pays cleaner)
  cleaner       String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

enum ChannelType {
  airbnb
  booking
  lekkeslaap
  other
  manual
}

enum BookingSource {
  manual
  airbnb
  booking
  lekkeslaap
  import
}

enum BookingStatus {
  confirmed
  floating
  cancelled
}
